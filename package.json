{
	"name": "ci",
	"version": "0.0.0-semantic-release",
	"description": "Run npm ci using the appropriate Node package manager (npm, yarn, pnpm)",
	"keywords": [
		"npm",
		"yarn",
		"pnpm",
		"ci"
	],
	"license": "MIT",
	"repository": "privatenumber/ci",
	"funding": "https://github.com/privatenumber/ci?sponsor=1",
	"author": {
		"name": "Hiroki Osame",
		"email": "hiroki.osame@gmail.com"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"bin": "dist/cli.js",
	"packageManager": "pnpm@10.30.3+sha512.c961d1e0a2d8e354ecaa5166b822516668b7f44cb5bd95122d590dd81922f606f5473b6d23ec4a5be05e7fcd18e8488d47d978bbe981872f1145d06e9a740017",
	"scripts": {
		"type-check": "tsc",
		"lint": "lintroll --cache --node --ignore-pattern tests/fixtures .",
		"build": "pkgroll --target node12.0.0 --minify",
		"test": "tsx tests",
		"dev": "tsx watch tests",
		"prepack": "pnpm build && clean-pkg-json"
	},
	"devDependencies": {
		"@types/node": "^20.4.9",
		"clean-pkg-json": "^1.2.0",
		"execa": "^7.2.0",
		"fs-fixture": "^1.2.0",
		"lintroll": "^1.30.0",
		"manten": "^2.0.0",
		"pkgroll": "^1.11.0",
		"tsx": "^3.12.7",
		"typescript": "^5.9.3"
	}
}
